# ===================================================
# Artha Monitor - Root Environment Configuration
# ===================================================

# Database (PostgreSQL)
POSTGRES_USER=artha
POSTGRES_PASSWORD=arthapassword123
POSTGRES_DB=arthamonitor
POSTGRES_PORT=5432
DATABASE_URL=postgresql://artha:arthapassword123@localhost:5432/arthamonitor?schema=public

# API Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=artha-super-secure-production-jwt-secret-min-32-chars-long!
JWT_REFRESH_SECRET=artha-super-secure-refresh-jwt-secret-min-32-chars-long!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_JOB_TIMEOUT=30000

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
