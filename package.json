{
  "name": "artha-monitor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:worker\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=@artha-monitor/api",
    "dev:api": "npm run dev --workspace=@artha-monitor/api",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=@artha-monitor/worker",
    "build": "npm run build --workspace=@artha-monitor/shared && npm run build --workspace=@artha-monitor/api && npm run build --workspace=@artha-monitor/worker && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=@artha-monitor/shared && npm run build --workspace=frontend",
    "build:web": "npm run build --workspace=@artha-monitor/shared && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=@artha-monitor/api",
    "build:api": "npm run build --workspace=@artha-monitor/api",
    "build:worker": "npm run build --workspace=@artha-monitor/worker",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace=@artha-monitor/api",
    "db:push": "npm run db:push --workspace=@artha-monitor/api",
    "db:migrate": "npm run db:migrate --workspace=@artha-monitor/api",
    "db:seed": "npm run db:seed --workspace=@artha-monitor/api",
    "db:studio": "npm run db:studio --workspace=@artha-monitor/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
